---
layout: default
---
<article class="portfolio-detail">
  <header class="portfolio-detail-header">
    <div class="portfolio-detail-classification">
      <span class="portfolio-label">{{ page.label }}</span>
      <span>{{ page.status }}</span>
    </div>
    <h1>{{ page.title }}</h1>
    <div class="portfolio-detail-meta">
      {% if page.authors %}<p class="portfolio-authors">{{ page.authors }}</p>{% endif %}
      {% if page.display_date or page.location %}
        <p class="portfolio-meta">{{ page.display_date }}{% if page.location %} · {{ page.location }}{% endif %}</p>
      {% endif %}
    </div>
  </header>

  <div class="portfolio-detail-grid">
    <aside class="portfolio-detail-aside">
      {% assign detail_image = page.detail_image | default: page.image %}
      {% assign detail_image_alt = page.detail_image_alt | default: page.image_alt %}
      <img class="portfolio-detail-preview" src="{{ detail_image | relative_url }}" alt="{{ detail_image_alt }}" loading="eager">
      <div class="portfolio-actions">
        {% if page.external_url %}
          <a class="portfolio-button portfolio-button-primary" href="{{ page.external_url }}" rel="external nofollow noopener" target="_blank">
            {{- page.external_label | default: 'Open documentation' }}
            <span aria-hidden="true">↗</span></a
          >
        {% elsif page.pdf %}
          <a class="portfolio-button portfolio-button-primary" href="{{ page.pdf | relative_url }}">
            Open PDF
            <span aria-hidden="true">↗</span></a
          >
        {% endif %}
        {% if page.secondary_pdf %}
          <a class="portfolio-button portfolio-button-primary" href="{{ page.secondary_pdf | relative_url }}">
            {{- page.secondary_pdf_label | default: 'Supporting PDF' }}
            <span aria-hidden="true">↗</span></a
          >
        {% endif %}
        {% if page.resource_url %}
          <a class="portfolio-button portfolio-button-primary" href="{{ page.resource_url }}" rel="external nofollow noopener" target="_blank">
            {{- page.resource_label | default: 'Open resource' }}
            <span aria-hidden="true">↗</span></a
          >
        {% endif %}
        {% if page.github %}
          <a class="portfolio-button portfolio-button-primary" href="{{ page.github }}">
            <span class="portfolio-button-label"><i class="fa-brands fa-github" aria-hidden="true"></i> GitHub</span>
            <span aria-hidden="true">↗</span>
          </a>
        {% endif %}
      </div>
      <p class="portfolio-aside-label">Topics</p>
      <div class="portfolio-tags" aria-label="Topics">
        {% for tag in page.tags -%}
          <span>{{ tag }}</span>
        {%- endfor %}
      </div>
    </aside>

    <div class="portfolio-detail-content">
      {% if page.video_id %}
        <div class="portfolio-video">
          <iframe src="https://www.youtube-nocookie.com/embed/{{ page.video_id | escape }}" title="Recorded talk on YouTube" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      {% endif %}
      <section class="portfolio-reading-section">
        <h2>Summary</h2>
        <p>{{ page.summary }}</p>
        {% if page.formula %}
          <div class="portfolio-formula portfolio-math-display">$$ {{ page.formula }} $$</div>
        {% endif %}
      </section>
      {% if page.framing %}
        <section class="portfolio-reading-section">
          <h2>Context</h2>
          <p>{{ page.framing }}</p>
        </section>
      {% endif %}
      {% if page.contributions and page.contributions.size > 0 %}
      <section class="portfolio-reading-section">
        <h2>Main contributions</h2>
        <ul>
          {% for contribution in page.contributions %}
            <li>{{ contribution }}</li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
      {{ content }}
    </div>
  </div>
</article>

{% if page.portfolio_type == 'paper' %}
{% assign work_kind = page.card_kind | default: '' | downcase %}
<script type="application/ld+json" id="academic-work-jsonld">
{
  "@context": "https://schema.org",
  "@type": {% if work_kind contains 'lecture' or work_kind contains 'tutorial' %}"LearningResource"{% else %}"ScholarlyArticle"{% endif %},
  "@id": {{ page.url | append: '#work' | absolute_url | jsonify }},
  "headline": {{ page.title | jsonify }},
  "url": {{ page.url | absolute_url | jsonify }},
  "mainEntityOfPage": {{ page.url | absolute_url | jsonify }},
  "description": {{ page.summary | strip_html | jsonify }},
  "creativeWorkStatus": {{ page.label | jsonify }},
  "additionalProperty": {
    "@type": "PropertyValue",
    "name": "Research or editorial stage",
    "value": {{ page.status | jsonify }}
  },
  "keywords": {{ page.tags | jsonify }},
  "inLanguage": "en"{% if page.authors %},
  "author": [
    {% assign work_authors = page.authors | split: ' and ' %}
    {% for author_name in work_authors %}
    {
      "@type": "Person",
      "name": {{ author_name | strip | jsonify }}{% if author_name contains 'Heriberto' %},
      "url": {{ '/' | absolute_url | jsonify }},
      "sameAs": "https://orcid.org/{{ site.data.socials.orcid_id }}"{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]{% endif %}{% if page.pdf %},
  "encoding": {
    "@type": "MediaObject",
    "encodingFormat": "application/pdf",
    "contentUrl": {{ page.pdf | absolute_url | jsonify }}
  }{% endif %}
}
</script>
{% endif %}
