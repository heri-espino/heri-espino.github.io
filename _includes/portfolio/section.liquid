<section class="portfolio-section portfolio-home-section" id="{{ include.id }}" aria-labelledby="{{ include.id }}-title">
  <div class="portfolio-section-heading">
    <div>
      <p class="portfolio-kicker">{{ include.eyebrow }}</p>
      <h2 id="{{ include.id }}-title">
        <a class="portfolio-section-title-link" href="{{ include.index_url | relative_url }}">
          <span>{{ include.title }}</span>
        </a>
      </h2>
      {% if include.intro %}
        <p class="portfolio-section-intro">{{ include.intro }}</p>
      {% endif %}
      {% if include.support %}
        <p class="portfolio-section-support">{{ include.support }}</p>
      {% endif %}
    </div>
    <a class="portfolio-section-link" href="{{ include.index_url | relative_url }}">
      {{- include.top_link }}
      <span aria-hidden="true">→</span></a
    >
  </div>
  <div class="portfolio-grid">
    {% for item in include.items %}
      {% include portfolio/card.liquid item=item %}
    {% endfor %}
  </div>
  {% if include.preview_items and include.preview_items.size > 0 %}
    <div class="portfolio-more-work">
      <div class="portfolio-more-teaser">
        {% for item in include.preview_items %}
          <a
            class="portfolio-more-teaser-card"
            href="{{ include.index_url | relative_url }}"
            aria-label="{{ include.bottom_link }} — {{ item.card_title | default: item.title }}"
          >
            <span class="portfolio-more-teaser-inner" aria-hidden="true">
              <img src="{{ item.image | relative_url }}" alt="" loading="lazy">
              <span class="portfolio-more-teaser-copy">
                <span class="portfolio-label">{{ item.label }}</span>
                <strong>{{ item.card_title | default: item.title }}</strong>
              </span>
            </span>
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}
  <a class="portfolio-archive-cta" href="{{ include.index_url | relative_url }}">
    {{- include.bottom_link }}
    <span aria-hidden="true">→</span></a
  >
  {% if include.additional_url %}
    <a class="portfolio-section-profile-link" href="{{ include.additional_url }}" rel="external nofollow noopener" target="_blank">
      {{- include.additional_link }}
      <span aria-hidden="true">↗</span></a
    >
  {% endif %}
</section>
