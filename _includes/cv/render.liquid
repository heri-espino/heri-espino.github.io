{% assign cv = site.data.cv.cv %}

<div class="post cv-page" id="cv-page" data-cv-template="personal" data-cv-font="site" data-cv-density="balanced" data-cv-preview="reading" data-cv-markers="dashes" data-cv-paper="a4" data-cv-show-urls="false" data-cv-tools="closed">
  <div class="cv-workspace">
    <div class="cv-controls-column">
      <div class="cv-controls-toolbar" aria-label="CV settings and export">
        <button type="button" id="cv-panel-toggle" class="cv-panel-toggle cv-icon-control" aria-controls="cv-settings-panel" aria-expanded="false" aria-label="Show CV settings" title="Show CV settings"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
        <button type="button" id="cv-print" class="cv-primary-action cv-icon-control" aria-label="Print or save CV as PDF" title="Print / Save as PDF"><i class="fa-solid fa-print" aria-hidden="true"></i></button>
      </div>

      <aside class="cv-tools" id="cv-settings-panel" aria-label="Customize and print CV" hidden>
    <div class="cv-tools-heading">
      <div>
        <h2>Customize CV</h2>
        <p>Change templates and content while the preview stays visible on the right.</p>
      </div>
      <span class="cv-tools-note">Print / Save as PDF uses your browser's print dialog.</span>
    </div>
    <div class="cv-tools-grid">
      <label for="cv-order">Order
        <select id="cv-order">
          <option value="sections">Grouped by section</option>
          <option value="newest">All entries: newest first</option>
          <option value="oldest">All entries: oldest first</option>
        </select>
      </label>
      <label for="cv-template">Template
        <select id="cv-template">
          <option value="personal">Personal · navy</option>
          <option value="harvard">Harvard-inspired · classic</option>
          <option value="europass">Europass-inspired · European CV</option>
          <option value="minimal">Modern minimal</option>
          <option value="editorial">Research editorial</option>
          <option value="professional">Compact professional</option>
        </select>
      </label>
      <label for="cv-font">Font
        <select id="cv-font">
          <option value="site">Helvetica Neue / sans-serif</option>
          <option value="arial">Arial</option>
          <option value="georgia">Georgia</option>
          <option value="times">Times New Roman</option>
          <option value="garamond">Garamond / serif</option>
        </select>
      </label>
      <label for="cv-paper">Paper size
        <select id="cv-paper">
          <option value="a4">A4</option>
          <option value="letter">US Letter</option>
        </select>
      </label>
      <label for="cv-density">Spacing
        <select id="cv-density">
          <option value="balanced" selected>Balanced</option>
          <option value="compact">Compact</option>
          <option value="latex">LaTeX · extra compact</option>
        </select>
      </label>
      <label for="cv-markers">Description markers
        <select id="cv-markers">
          <option value="dashes" selected>Em dashes (—)</option>
          <option value="bullets">Bullets (•)</option>
          <option value="none">No markers</option>
        </select>
      </label>
      <label for="cv-palette">Accent color
        <select id="cv-palette">
          <option value="default">Template default</option>
          <option value="velvet">Velvet blue</option>
          <option value="sapphire">Sapphire</option>
          <option value="teal">Teal</option>
          <option value="forest">Forest</option>
          <option value="burgundy">Burgundy</option>
          <option value="graphite">Graphite</option>
          <option value="custom">Custom</option>
        </select>
      </label>
      <label for="cv-custom-accent">Custom color
        <input type="color" id="cv-custom-accent" value="#00104c" disabled aria-label="Choose a custom CV accent color">
      </label>
    </div>
    <details class="cv-section-picker">
      <summary>Sections to include</summary>
      <div class="cv-section-picker-grid">
        {% for section_pair in cv.sections %}
          {% assign title = section_pair[0] %}
          <label>
            <input type="checkbox" data-cv-section-toggle="{{ title | slugify }}" checked>
            {{ title }}
          </label>
        {% endfor %}
      </div>
    </details>

    <details class="cv-print-options" id="cv-print-options">
      <summary>Print content and layout</summary>
      <p class="cv-tools-help">These choices affect the live preview and the printed PDF. The full CV remains in the source data.</p>
      <div class="cv-print-options-grid">
        <label><input type="checkbox" data-cv-print-toggle="icons" checked> Show icons</label>
        <label><input type="checkbox" data-cv-print-toggle="dates" checked> Show dates</label>
        <label><input type="checkbox" data-cv-print-toggle="locations" checked> Show locations</label>
        <label><input type="checkbox" data-cv-print-toggle="credentials" checked> Show credential IDs</label>
        <label><input type="checkbox" data-cv-print-toggle="organizations" checked> Show institutions and employers</label>
        <label><input type="checkbox" data-cv-print-toggle="highlights" checked> Show descriptions</label>
        <label><input type="checkbox" data-cv-print-toggle="links" checked> Show resource-link labels</label>
        <label><input type="checkbox" data-cv-print-toggle="contact" checked> Show header contact links</label>
      </div>
      <div class="cv-tools-grid cv-print-layout-grid">
        <label for="cv-text-size">Print text size
          <select id="cv-text-size">
            <option value="regular">Standard</option>
            <option value="small">Small</option>
            <option value="large">Large</option>
          </select>
        </label>
        <label for="cv-page-margin">Page margins
          <select id="cv-page-margin">
            <option value="latex" selected>LaTeX (10 mm)</option>
            <option value="standard">Standard (13 mm)</option>
            <option value="narrow">Narrow (8 mm)</option>
            <option value="wide">Wide (19 mm)</option>
          </select>
        </label>
      </div>
    </details>
    <details class="cv-entry-picker" id="cv-entry-picker">
      <summary>Choose individual entries <span id="cv-entry-count"></span></summary>
      <p class="cv-tools-help">Exclude individual activities, competitions, research, experience, or credentials without removing them from your full CV. Entire-section exclusions take priority.</p>
      <label class="cv-entry-search-label" for="cv-entry-search">Find entries
        <input type="search" id="cv-entry-search" placeholder="Search titles or sections">
      </label>
      <div class="cv-entry-picker-actions">
        <button type="button" id="cv-entries-all">Include all entries</button>
        <button type="button" id="cv-entries-none">Exclude all entries</button>
      </div>
      <div class="cv-entry-options" id="cv-entry-options"></div>
    </details>
    <label class="cv-print-links-option" for="cv-print-urls">
      <input type="checkbox" id="cv-print-urls"> Show full resource URLs on printed copies (clickable links are always retained)
    </label>
    <div class="cv-actions">
      <button type="button" id="cv-preview" class="cv-secondary-action" aria-pressed="false">Paper preview</button>
      <button type="button" id="cv-reset" class="cv-secondary-action">Reset options</button>
      <p id="cv-status" role="status" aria-live="polite"></p>
    </div>
    <p class="cv-preview-help" id="cv-preview-help">Full-width CV view. Paper preview uses the extra-compact print spacing by default; Print / Save as PDF uses your browser.</p>
    <p class="cv-disclaimer">
      The Harvard-inspired and Europass-inspired options are independent academic CV styles, not official university or EU-issued templates.
      For an official Europass document, use the <a href="https://europass.europa.eu/en/create-europass-cv" target="_blank" rel="noopener noreferrer">EU Europass CV builder</a>.
      Chronological sorting uses each entry's first listed date. Undated sections remain after the timeline.
    </p>
      </aside>
    </div>
    <div class="cv-preview-column">
      <div class="cv-document" id="cv-document" aria-label="Live curriculum vitae preview">
  <header class="post-header cv-intro">
    <p class="cv-eyebrow">Curriculum vitae</p>
    <p class="cv-europass-personal-heading">Personal information</p>
    <h1 class="post-title">{{ cv.name }}</h1>
    <p class="post-description">{{ page.description }}</p>
    <nav class="cv-contact" aria-label="CV contact links">
      <a href="mailto:{{ cv.email }}">{{ cv.email }}</a>
      {% for social in cv.social_networks %}
        <a href="{{ social.url }}" target="_blank" rel="noopener noreferrer">{{ social.network }}</a>
      {% endfor %}
      <a href="{{ cv.website }}" target="_blank" rel="noopener noreferrer">Portfolio</a>
    </nav>
  </header>
  <section id="cv-timeline" class="cv-timeline" aria-label="Chronological CV" hidden>
    <h2>Chronological record</h2>
    <div id="cv-timeline-items" class="cv-entry-list"></div>
  </section>

  <article class="cv-content" id="cv-sections">
    {% for section_pair in cv.sections %}
      {% assign title = section_pair[0] %}
      {% assign entries = section_pair[1] %}
      {% assign expandable = false %}
      {% if title == 'Selected Extracurricular Activities' or title == 'Credentials' %}
        {% assign expandable = true %}
      {% endif %}

      <section class="cv-section" data-cv-section="{{ title | slugify }}" data-cv-title="{{ title | escape }}" aria-labelledby="{{ title | slugify }}-heading">
        {% if expandable %}
          <details class="cv-details" open>
            <summary>
              <span id="{{ title | slugify }}-heading">{{ title }}</span>
              <span class="cv-details-count">{{ entries.size }} entries</span>
            </summary>
            <div class="cv-details-body">
        {% else %}
          <h2 id="{{ title | slugify }}-heading">{{ title }}</h2>
        {% endif %}

        {% if title == 'Technical Skills' %}
          <dl class="cv-skills">
            {% for entry in entries %}
              <div>
                <dt><span class="cv-skills-icon" aria-hidden="true"><i class="fa-solid fa-screwdriver-wrench"></i></span>{{ entry.name }}</dt>
                <dd>{{ entry.values }}</dd>
              </div>
            {% endfor %}
          </dl>
        {% elsif title == 'Languages' %}
          <ul class="cv-inline-list">
            {% for entry in entries %}
              <li>
                <span class="cv-language-icon" aria-hidden="true"><i class="fa-solid fa-language"></i></span><strong>{{ entry.name }}</strong> — {{ entry.values }}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="{% if title == 'Education' or title == 'Professional Experience' or title == 'Research' or title == 'Programming Experience' %}cv-entry-list{% else %}cv-compact-grid{% endif %}">
            {% for entry in entries %}
              <article
                class="{% if title == 'Education' or title == 'Professional Experience' or title == 'Research' or title == 'Programming Experience' %}cv-entry{% else %}cv-compact-entry{% endif %}"
                data-cv-record
                data-cv-date="{{ entry.date | default: '' | escape }}"
              >
                <div class="cv-entry-heading">
                  <div>
                    <h3>
                      {% assign cv_primary_link = entry.url %}
                      {% unless cv_primary_link %}
                        {% if entry.links and entry.links.size > 0 %}
                          {% assign cv_primary_link = entry.links.first.url %}
                        {% endif %}
                      {% endunless %}
                      {% if cv_primary_link %}<a href="{{ cv_primary_link }}" class="cv-primary-link" target="_blank" rel="noopener noreferrer">{% endif %}
                      {% assign cv_entry_icon = 'fa-file-lines' %}
                      {% case title %}
                        {% when 'Education' %}{% assign cv_entry_icon = 'fa-graduation-cap' %}
                        {% when 'Professional Experience' %}{% assign cv_entry_icon = 'fa-briefcase' %}
                        {% when 'Programming Experience' %}{% assign cv_entry_icon = 'fa-code' %}
                        {% when 'Academic Experience' %}{% assign cv_entry_icon = 'fa-chalkboard-user' %}
                        {% when 'Awards' %}{% assign cv_entry_icon = 'fa-trophy' %}
                        {% when 'Research' %}{% assign cv_entry_icon = 'fa-flask' %}
                        {% when 'Selected Academic Projects' %}{% assign cv_entry_icon = 'fa-diagram-project' %}
                        {% when 'Leadership' %}{% assign cv_entry_icon = 'fa-users' %}
                        {% when 'Schools' %}{% assign cv_entry_icon = 'fa-school' %}
                        {% when 'Selected Extracurricular Activities' %}{% assign cv_entry_icon = 'fa-medal' %}
                        {% when 'Credentials' %}{% assign cv_entry_icon = 'fa-certificate' %}
                        {% when 'Volunteering' %}{% assign cv_entry_icon = 'fa-hand-holding-heart' %}
                      {% endcase %}
                      <span class="cv-entry-symbol" aria-hidden="true"><i class="fa-solid {{ entry.icon | default: cv_entry_icon }}"></i></span>
                      {% if entry.role %}<span class="cv-entry-role">{{ entry.role }}</span><span class="cv-entry-separator" aria-hidden="true"> · </span>{% endif %}
                      <span class="cv-entry-name" title="{{ entry.degree | default: entry.name | escape }}">{{ entry.subtitle | default: entry.degree | default: entry.name }}</span>
                      {% if cv_primary_link %}<i class="fa-solid fa-arrow-up-right-from-square cv-link-icon" aria-hidden="true"></i></a>{% endif %}
                    </h3>
                    {% assign cv_org_name = entry.institution | default: entry.organization | default: '' | downcase %}
                    {% assign cv_org_logo = nil %}
                    {% for cv_logo_rule in site.data.cv_organization_logos %}
                      {% if cv_org_name contains cv_logo_rule.match %}
                        {% if cv_logo_rule.issuer_key %}
                          {% assign cv_issuer_logo = site.data.credential_issuers[cv_logo_rule.issuer_key] %}
                          {% assign cv_org_logo = cv_issuer_logo.logo %}
                        {% else %}
                          {% assign cv_org_logo = cv_logo_rule.logo %}
                        {% endif %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                    {% assign cv_fallback_icon = 'fa-building-columns' %}
                    {% if cv_org_name contains 'actinver' %}
                      {% assign cv_fallback_icon = 'fa-chart-line' %}
                    {% elsif cv_org_name contains 'openai' or cv_org_name contains 'python library' %}
                      {% assign cv_fallback_icon = 'fa-code' %}
                    {% elsif cv_org_name contains 'paletas loreto' %}
                      {% assign cv_fallback_icon = 'fa-store' %}
                    {% elsif cv_org_name contains 'springer' or cv_org_name contains 'journal' %}
                      {% assign cv_fallback_icon = 'fa-book-open' %}
                    {% elsif cv_org_name contains 'research' %}
                      {% assign cv_fallback_icon = 'fa-flask' %}
                    {% endif %}
                    {% if entry.institution %}
                      <p class="cv-organization">
                        <span class="cv-org-symbol" aria-hidden="true">
                          {% if cv_org_logo %}
                            <img class="cv-org-logo" src="{{ cv_org_logo | escape }}" alt="" width="16" height="16" data-cv-org-logo hidden>
                          {% endif %}
                          <i class="fa-solid {{ cv_fallback_icon }} cv-org-icon" aria-hidden="true"></i>
                        </span>
                        {% if entry.institution_url %}<a href="{{ entry.institution_url }}" target="_blank" rel="noopener noreferrer">{% endif %}
                        {{ entry.institution }}
                        {% if entry.institution_url %}</a>{% endif %}
                      </p>
                    {% endif %}
                    {% if entry.organization %}
                      <p class="cv-organization">
                        <span class="cv-org-symbol" aria-hidden="true">
                          {% if cv_org_logo %}
                            <img class="cv-org-logo" src="{{ cv_org_logo | escape }}" alt="" width="16" height="16" data-cv-org-logo hidden>
                          {% endif %}
                          <i class="fa-solid {{ cv_fallback_icon }} cv-org-icon" aria-hidden="true"></i>
                        </span>
                        {% if entry.organization_url %}<a href="{{ entry.organization_url }}" target="_blank" rel="noopener noreferrer">{% endif %}
                        {{ entry.organization }}
                        {% if entry.organization_url %}</a>{% endif %}
                      </p>
                    {% endif %}
                    {% if entry.links %}
                      <p class="cv-links">
                        {% for link in entry.links %}
                          <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
                        {% endfor %}
                      </p>
                    {% endif %}
                  </div>
                  <p class="cv-meta">
                    {% if entry.date %}<span class="cv-date">{{ entry.date }}</span>{% endif %}
                    {% if entry.location %}<span class="cv-location">{{ entry.location }}</span>{% endif %}
                    {% if entry.credential %}<span class="cv-credential">{{ entry.credential }}</span>{% endif %}
                  </p>
                </div>
                {% if entry.highlights %}
                  <ul class="cv-highlights">
                    {% for item in entry.highlights %}
                      <li>{{ item }}</li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        {% endif %}

        {% if expandable %}
          </div>
          </details>
        {% endif %}
      </section>
    {% endfor %}
  </article>
      </div>
      <div class="cv-paged-preview" id="cv-paged-preview" aria-label="Page-by-page CV preview" hidden></div>
    </div>
  </div>
</div>

<script src="{{ '/assets/js/cv-customize.js' | relative_url }}" defer></script>
